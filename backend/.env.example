ENV=dev
DATABASE_URL=postgresql://cartographer:cartographer@localhost:55432/cartographer
TEST_DATABASE_URL=postgresql://cartographer:cartographer@localhost:55432/cartographer_test
DB_SCHEMA=cartographer
DB_POOL_MIN=1
DB_POOL_MAX=5
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_CONCURRENCY=4
VOYAGE_API_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_CONCURRENCY=4
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_MAX_CONCURRENCY=4
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=repo-cartographer
CUSTOM_API_KEY=
CUSTOM_BASE_URL=http://localhost:8000/v1
CUSTOM_TIMEOUT_SECONDS=120
CUSTOM_MAX_CONCURRENCY=4
GITHUB_TOKEN=
DATA_DIR=./data
LOG_LEVEL=INFO
LOG_FORMAT=console
CORS_ORIGINS=http://localhost:5173
MAX_REPOS=5
MAX_REPO_FILES=5000
MAX_FILE_BYTES=500000
MAX_REPO_SOURCE_BYTES=25000000
MAX_CHUNKS_PER_REPO=15000
GIT_TIMEOUT_SECONDS=120
CLONE_TIMEOUT_SECONDS=300
GIT_MAX_CONCURRENCY=2
MAX_REMOTE_REPO_SIZE_MB=500
PROVIDER_MAX_RETRIES=5
PROVIDER_BACKOFF_BASE_SECONDS=1
PROVIDER_BACKOFF_MAX_SECONDS=30
EMBED_TIMEOUT_SECONDS=60
EMBED_MAX_CONCURRENCY=2
EMBED_BATCH_MAX_TEXTS=64
EMBED_BATCH_MAX_TOKENS=50000
# Optional client-side limits. Leave blank to disable.
VOYAGE_RPM_LIMIT=
VOYAGE_TPM_LIMIT=
INDEX_WINDOW_FILES=25
INDEX_STALE_AFTER_MINUTES=30
REQUIRE_EXACT_TOKENIZER=false
QUERY_EMBED_TIMEOUT_SECONDS=20
